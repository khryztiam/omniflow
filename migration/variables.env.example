# Configuracion requerida para conectar OmniFlow al nuevo proyecto Supabase.
# Completar en el entorno de despliegue; no guardar credenciales reales aqui.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Dominio usado para construir los correos de acceso.
NEXT_PUBLIC_APP_DOMAIN=@omniflow.com

# Variables opcionales para scripts de desarrollo/pruebas. No usar credenciales
# de prueba en produccion.
BASE_URL=http://localhost:3000
TEST_USERNAME=usuario1
TEST_EMAIL=
TEST_PASSWORD=
DEFAULT_TEST_PASSWORD=
TEST_TASK_ID=
TEST_TASK_TITLE=
